# EDGE HUNTER local configuration example
EDGE_HUNTER_ENV=development
EDGE_HUNTER_DEBUG=true
EDGE_HUNTER_API_HOST=127.0.0.1
EDGE_HUNTER_API_PORT=8000
EDGE_HUNTER_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
EDGE_HUNTER_CORS_ORIGINS=

# Authentication/security tuning
EDGE_HUNTER_SESSION_TTL_HOURS=24
EDGE_HUNTER_PASSWORD_ITERATIONS=600000
EDGE_HUNTER_LOGIN_RATE_LIMIT=5
EDGE_HUNTER_RATE_LIMIT_WINDOW_SECONDS=300
EDGE_HUNTER_COOKIE_SECURE=false

# Public-edge controls
EDGE_HUNTER_PUBLIC_RATE_LIMIT=120
EDGE_HUNTER_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
EDGE_HUNTER_MAX_REQUEST_BYTES=65536
EDGE_HUNTER_DOCS_ENABLED=true
EDGE_HUNTER_TRUST_PROXY_HEADERS=false
EDGE_HUNTER_LOG_DIR=logs

# Live market data. Live Analysis reads OHLC from Twelve Data only; local CSV
# files (data/raw) are for backtesting/learning and are never used as live data.
# EDGE_HUNTER_DATA_MODE=local is an explicit offline mode for development/tests.
EDGE_HUNTER_DATA_MODE=live
EDGE_HUNTER_LIVE_PROVIDER=twelvedata
EDGE_HUNTER_LIVE_PROVIDER_ENABLED=true
EDGE_HUNTER_LIVE_PROVIDER_API_KEY=
EDGE_HUNTER_LIVE_PROVIDER_URL=https://api.twelvedata.com
EDGE_HUNTER_LIVE_PROVIDER_TIMEOUT_SECONDS=10
EDGE_HUNTER_LIVE_PROVIDER_MAX_RETRIES=2
EDGE_HUNTER_LIVE_PROVIDER_BACKOFF_SECONDS=0.5
EDGE_HUNTER_LIVE_PROVIDER_CACHE_TTL_SECONDS=15
EDGE_HUNTER_LIVE_PROVIDER_MAX_BARS=800
EDGE_HUNTER_LIVE_PROVIDER_RATE_LIMIT_PER_MINUTE=8

# L10 continuous learning (safe defaults)
EDGE_HUNTER_LEARNING_ENABLED=false
EDGE_HUNTER_LEARNING_AUTOMATIC_RETRAINING_ENABLED=false
EDGE_HUNTER_LEARNING_AUTOMATIC_PROMOTION_ENABLED=false
EDGE_HUNTER_LEARNING_PRODUCTION_ENABLED=false
EDGE_HUNTER_LEARNING_SCHEDULE_INTERVAL_SECONDS=3600
EDGE_HUNTER_LEARNING_MINIMUM_NEW_COMPLETED_RECORDS=1
EDGE_HUNTER_LEARNING_MINIMUM_DATASET_SIZE=1
EDGE_HUNTER_LEARNING_COOLDOWN_SECONDS=3600
EDGE_HUNTER_LEARNING_MAX_RETRIES=2
EDGE_HUNTER_LEARNING_MINIMUM_MONITORING_SAMPLE=10
EDGE_HUNTER_LEARNING_DRIFT_THRESHOLD=0.25
EDGE_HUNTER_LEARNING_ROLLBACK_GRACE_PERIOD_SECONDS=3600

# Web symbol catalog
EDGE_HUNTER_SYMBOL_CATALOG_CACHE_TTL_SECONDS=86400
EDGE_HUNTER_SYMBOL_SEARCH_LIMIT=20
