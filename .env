# EDGE HUNTER local configuration
EDGE_HUNTER_ENV=development
EDGE_HUNTER_DEBUG=true
EDGE_HUNTER_API_HOST=127.0.0.1
EDGE_HUNTER_API_PORT=8000
EDGE_HUNTER_ALLOWED_HOSTS=127.0.0.1,localhost
EDGE_HUNTER_CORS_ORIGINS=

# Optional infrastructure
# EDGE_HUNTER_DATABASE_PATH=C:\path\to\edge_hunter.db
# EDGE_HUNTER_LIVE_PROVIDER_URL=
# EDGE_HUNTER_WHATSAPP_URL=https://wa.me/<owner-number>

# Authentication/security tuning
EDGE_HUNTER_SESSION_TTL_HOURS=24
EDGE_HUNTER_PASSWORD_ITERATIONS=600000
EDGE_HUNTER_LOGIN_RATE_LIMIT=5
EDGE_HUNTER_RATE_LIMIT_WINDOW_SECONDS=300
# Development should normally remain false; production should be true.
EDGE_HUNTER_COOKIE_SECURE=false

# No admin password is stored here. Create the first admin with:
# python scripts/create_admin.py --email admin@example.com

# Public-edge controls (Phase 11)
EDGE_HUNTER_PUBLIC_RATE_LIMIT=120
EDGE_HUNTER_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
EDGE_HUNTER_MAX_REQUEST_BYTES=65536
EDGE_HUNTER_DOCS_ENABLED=true
EDGE_HUNTER_TRUST_PROXY_HEADERS=false
EDGE_HUNTER_LOG_DIR=logs

# Production example:
# EDGE_HUNTER_ENV=production
# EDGE_HUNTER_DEBUG=false
# EDGE_HUNTER_API_HOST=127.0.0.1
# EDGE_HUNTER_ALLOWED_HOSTS=app.example.com
# EDGE_HUNTER_CORS_ORIGINS=
# EDGE_HUNTER_COOKIE_SECURE=true
# EDGE_HUNTER_DOCS_ENABLED=false
# EDGE_HUNTER_TRUST_PROXY_HEADERS=true   # only when behind a trusted local proxy/tunnel

# Live market data (Phase 13)
# Live Analysis reads OHLC from Twelve Data only. Local CSV files (data/raw)
# are for backtesting/learning and are never used as live data.
EDGE_HUNTER_DATA_MODE=live
EDGE_HUNTER_LIVE_PROVIDER=twelvedata
EDGE_HUNTER_LIVE_PROVIDER_ENABLED=true
EDGE_HUNTER_LIVE_PROVIDER_API_KEY="ضع المفتاح هنا"
EDGE_HUNTER_LIVE_PROVIDER_URL=https://api.twelvedata.com
EDGE_HUNTER_LIVE_PROVIDER_TIMEOUT_SECONDS=10
EDGE_HUNTER_LIVE_PROVIDER_MAX_RETRIES=2
EDGE_HUNTER_LIVE_PROVIDER_BACKOFF_SECONDS=0.5
EDGE_HUNTER_LIVE_PROVIDER_CACHE_TTL_SECONDS=15
EDGE_HUNTER_LIVE_PROVIDER_MAX_BARS=800
EDGE_HUNTER_LIVE_PROVIDER_RATE_LIMIT_PER_MINUTE=8
